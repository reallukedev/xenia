<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Xenia's privacy manifest, shared by the app and its extensions. Xenia doesn't track and
  collects nothing for itself: messages go to the person's own homeserver. The reasons below
  cover the required-reason APIs that Xenia and its Rust core (SQLite, Tokio) call.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Preferences and launch state, read by the app itself. -->
				<string>CA92.1</string>
				<!-- The App Group's defaults, shared with the notification extensions. -->
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- The stores and caches inside Xenia's own containers. -->
				<string>C617.1</string>
				<!-- Photos and files the person chooses to send. -->
				<string>3B52.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Timers and timeouts measure elapsed time; nothing leaves the device. -->
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryActiveKeyboards</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Choosing an emoji for a Tapback brings up the emoji keyboard, if one is on. -->
				<string>54BD.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
